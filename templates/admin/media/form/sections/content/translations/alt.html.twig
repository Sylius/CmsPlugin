{% set form = hookable_metadata.context.form %}

<div class="col-12 col-md-6 {{ hookable_metadata.context.media_type != 'image' ? 'd-none' }}">
    {{ form_row(form.alt, sylius_test_form_attribute('alt')|merge({
        help: 'sylius_cms.ui.media_form.alt_help',
        attr: { placeholder: 'sylius_cms.ui.media_form.alt_placeholder'|trans }|merge(sylius_test_form_attribute('alt').attr|default({})),
    })) }}
</div>
