{% set form = hookable_metadata.context.form %}
{% set media = hookable_metadata.context.media %}
{% set controller = '@sylius-cms-plugin/admin/media-upload' %}
{% set submit_label = (media.id is null ? 'sylius.ui.create' : 'sylius.ui.update')|trans %}
{% set file_name = media.path is not empty ? media.path|split('/')|last : null %}

<div class="col-12" {{ sylius_test_html_attribute('media-file') }}>
    <div class="cms-media-stage">
        {% if media.path is not empty %}
            <div class="cms-media-current" {{ sylius_test_html_attribute('media-current') }}>
                <div class="cms-media-stage-label text-secondary small fw-bold text-uppercase mb-2">{{ 'sylius_cms.ui.media_form.current'|trans }}</div>
                <div class="cms-media-frame position-relative">
                    {% if media.type == 'image' %}
                        {% set url = media.path|imagine_filter('sylius_original') %}
                        <img src="{{ url }}" alt="{{ media.alt }}">
                        <a href="{{ url }}" target="_blank" rel="noopener" class="btn btn-sm cms-media-frame-link">
                            {{ ux_icon('tabler:external-link', { class: 'icon' }) }}{{ 'sylius_cms.ui.media_form.open_original'|trans }}
                        </a>
                    {% elseif media.type == 'video' %}
                        <video
                            controls
                            preload="metadata"
                            src="{{ media.path|sylius_cms_resolve_media_video_path }}"
                            {{ stimulus_target(controller, 'currentVideo') }}
                            {{ stimulus_action(controller, 'describeCurrentVideo', 'loadedmetadata') }}
                        ></video>
                    {% else %}
                        <div class="cms-media-file d-flex align-items-center gap-3 p-3">
                            <span class="avatar avatar-lg bg-red-lt fw-bold">{{ (file_name|split('.')|last)|upper|slice(0, 4) }}</span>
                            <div class="overflow-hidden">
                                <div class="fw-bold text-truncate">{{ file_name }}</div>
                                <div class="small text-secondary">{{ media.mimeType }}</div>
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <button type="button" class="btn btn-sm cms-media-replace" {{ stimulus_action(controller, 'browse') }} {{ sylius_test_html_attribute('media-replace') }}>
                        {{ ux_icon('tabler:replace', { class: 'icon' }) }}{{ 'sylius_cms.ui.media_form.replace'|trans }}
                    </button>
                    <span class="small text-secondary cms-media-replace">{{ 'sylius_cms.ui.media_form.drop_to_replace'|trans }}</span>
                </div>
                <dl class="cms-media-details">
                    <div><dt>{{ 'sylius_cms.ui.media_form.details.file_type'|trans }}</dt><dd>{{ media.mimeType ?? '—' }}</dd></div>
                    {% if media.type == 'image' and media.width is not null %}
                        <div><dt>{{ 'sylius_cms.ui.media_form.details.dimensions'|trans }}</dt><dd>{{ media.width }} × {{ media.height }} px</dd></div>
                    {% elseif media.type == 'video' %}
                        <div><dt>{{ 'sylius_cms.ui.media_form.details.resolution'|trans }}</dt><dd {{ stimulus_target(controller, 'currentResolution') }}>—</dd></div>
                        <div><dt>{{ 'sylius_cms.ui.media_form.details.duration'|trans }}</dt><dd {{ stimulus_target(controller, 'currentDuration') }}>—</dd></div>
                    {% endif %}
                    <div><dt>{{ 'sylius_cms.ui.media_form.details.file_name'|trans }}</dt><dd class="text-truncate" title="{{ file_name }}">{{ file_name }}</dd></div>
                </dl>
            </div>
        {% else %}
            <div class="cms-media-dropzone" {{ sylius_test_html_attribute('media-dropzone') }}>
                <span class="avatar avatar-lg rounded-circle bg-green-lt">{{ ux_icon('tabler:upload', { class: 'icon' }) }}</span>
                <div class="fs-3 fw-bold">{{ 'sylius_cms.ui.media_form.dropzone.title'|trans }}</div>
                <div class="text-secondary">
                    {{ 'sylius_cms.ui.media_form.dropzone.or'|trans }}
                    <button type="button" class="btn btn-sm ms-1" {{ stimulus_action(controller, 'browse') }}>{{ 'sylius_cms.ui.media_form.dropzone.browse'|trans }}</button>
                </div>
                <div class="small text-secondary">{{ 'sylius_cms.ui.media_form.dropzone.help'|trans }}</div>
            </div>
        {% endif %}

        <div class="cms-media-selected" data-live-ignore {{ sylius_test_html_attribute('media-selected') }}>
            {{ form_label(form.file, null, { label_attr: { class: 'visually-hidden' } }) }}
            {{ form_widget(form.file, { attr: { class: 'visually-hidden', tabindex: '-1' }
                |merge(stimulus_target(controller, 'input').toArray())
                |merge(stimulus_action(controller, 'select', 'change').toArray())
                |merge(sylius_test_form_attribute('file').attr|default({}))
            }) }}

            <div class="cms-media-stage-label mb-2">
                <span class="badge bg-orange-lt">{{ 'sylius_cms.ui.media_form.new_file'|trans }}</span>
            </div>
            <div class="cms-media-frame position-relative">
                <img alt="" hidden {{ stimulus_target(controller, 'selectedImage') }}>
                <video controls preload="metadata" hidden {{ stimulus_target(controller, 'selectedVideo') }}></video>
                <div class="cms-media-file align-items-center gap-3 p-3" hidden {{ stimulus_target(controller, 'selectedFile') }}>
                    <span class="avatar avatar-lg bg-red-lt fw-bold" {{ stimulus_target(controller, 'selectedExtension') }}></span>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-truncate" {{ stimulus_target(controller, 'selectedFileName') }}></div>
                        <div class="small text-secondary" {{ stimulus_target(controller, 'selectedFileType') }}></div>
                    </div>
                </div>
                <div class="cms-media-frame-actions d-flex gap-2">
                    <button type="button" class="btn btn-sm" {{ stimulus_action(controller, 'browse') }} {{ sylius_test_html_attribute('media-choose-another') }}>
                        {{ ux_icon('tabler:replace', { class: 'icon' }) }}{{ 'sylius_cms.ui.media_form.choose_another'|trans }}
                    </button>
                    <button type="button" class="btn btn-sm text-danger cms-media-remove" {{ stimulus_action(controller, 'clear') }} {{ sylius_test_html_attribute('media-remove') }}>
                        {{ 'sylius_cms.ui.media_form.remove'|trans }}
                    </button>
                </div>
            </div>
            <dl class="cms-media-details">
                <div><dt>{{ 'sylius_cms.ui.media_form.details.file_type'|trans }}</dt><dd {{ stimulus_target(controller, 'detailType') }}></dd></div>
                <div><dt>{{ 'sylius_cms.ui.media_form.details.size'|trans }}</dt><dd {{ stimulus_target(controller, 'detailSize') }}></dd></div>
                <div {{ stimulus_target(controller, 'detailDimensionsRow') }}><dt>{{ 'sylius_cms.ui.media_form.details.dimensions'|trans }}</dt><dd {{ stimulus_target(controller, 'detailDimensions') }}></dd></div>
                <div {{ stimulus_target(controller, 'detailDurationRow') }}><dt>{{ 'sylius_cms.ui.media_form.details.duration'|trans }}</dt><dd {{ stimulus_target(controller, 'detailDuration') }}></dd></div>
                <div><dt>{{ 'sylius_cms.ui.media_form.details.file_name'|trans }}</dt><dd class="text-truncate" {{ stimulus_target(controller, 'detailName') }}></dd></div>
            </dl>
            <div class="alert alert-info mb-0 cms-media-create-note">
                {{ 'sylius_cms.ui.media_form.selected_note'|trans({ '%button%': submit_label }) }}
            </div>
            <div class="alert alert-warning mb-0 cms-media-replace-note">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="flex-grow-1">{{ 'sylius_cms.ui.media_form.replace_note'|trans({ '%button%': submit_label }) }}</div>
                    <button type="button" class="btn btn-sm" {{ stimulus_action(controller, 'clear') }} {{ sylius_test_html_attribute('media-keep-current') }}>
                        {{ 'sylius_cms.ui.media_form.keep_current'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mt-3 mb-0 d-none" role="alert" {{ stimulus_target(controller, 'mismatch') }} {{ sylius_test_html_attribute('media-type-mismatch') }}>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="flex-grow-1" {{ stimulus_target(controller, 'mismatchText') }}></div>
            <button type="button" class="btn btn-sm" {{ stimulus_target(controller, 'switchType') }} {{ stimulus_action(controller, 'switchType') }}></button>
        </div>
    </div>

    {% for error in form.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
    {{ form_errors(form.file) }}
</div>
