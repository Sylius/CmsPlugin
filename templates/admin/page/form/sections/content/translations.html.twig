{% set form = hookable_metadata.context.form %}
{% set ui_state = hookable_metadata.context.ui_state %}

{% form_theme form.contentElements '@SyliusCmsPlugin/admin/page/content_elements_form_theme.html.twig' %}

{% for locale, translation_form in form.contentElements %}
    <div
        id="translation-elements-{{ locale }}"
        class="{{ ui_state.active_locale != locale ? 'd-none' }}"
        data-ui-pane="activeLocale"
        data-ui-pane-value="{{ locale }}"
    >
        <div class="row g-4" {{ sylius_test_html_attribute('elements-collection') }}>
            {% hook 'translations' with { form: translation_form, locale } %}
        </div>
    </div>
{% endfor %}
