{% import '@SyliusCmsPlugin/admin/page/macros/locale_panes.html.twig' as locale_panes %}

{% set form = hookable_metadata.context.form %}
{% set prefixes = hookable_metadata.prefixes %}

<div class="col-12 col-lg">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'sylius_cms.ui.teaser.header'|trans }}</h3>
                <p class="card-subtitle">{{ 'sylius_cms.ui.teaser.help'|trans }}</p>
            </div>
        </div>
        {{ locale_panes.with_hook(form.translations, prefixes, hookable_metadata.context.ui_state, 'teaser') }}
    </div>
</div>
