{% extends '@SyliusAdmin/shared/form_theme.html.twig' %}

{% block _sylius_cms_admin_page_translations_entry_slug_row %}
    {% set locale = form.parent.vars.name %}

    {{ form_label(form) }}
    <div class="input-group {{ errors|length > 0 ? 'has-validation' }}">
        <span class="input-group-text">{{ path('sylius_cms_shop_page_show', { _locale: locale, slug: '__slug__' })|replace({ '__slug__': '' }) }}</span>
        {{ form_widget(form, sylius_test_form_attribute('slug', locale)) }}
        <button
            class="btn btn-outline-secondary"
            type="button"
            data-action="live#action"
            data-live-action-param="debounce(300)|generateSlug"
            data-live-locale-code-param="{{ locale }}"
            {{ sylius_test_html_attribute('generate-slug-button', locale) }}
        >
            {{ ux_icon('tabler:wand', {'class': 'icon'}) }}
            {{ 'sylius_cms.ui.page_form.seo.generate_slug'|trans }}
        </button>
        {{ form_errors(form) }}
    </div>
    <div class="mb-3"></div>
{% endblock %}
