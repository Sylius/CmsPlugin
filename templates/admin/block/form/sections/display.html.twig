<div
    id="form-tab-display"
    role="tabpanel"
    tabindex="0"
    class="tab-pane mb-3 {{ hookable_metadata.configuration.active|default(false) ? 'show active' }}"
>
    <div class="card" {{ sylius_test_html_attribute('block-display') }}>
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'sylius_cms.ui.block_form.display.title'|trans }}</h3>
                <p class="card-subtitle">{{ 'sylius_cms.ui.block_form.display.help'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                {% hook 'display' %}
            </div>
        </div>
    </div>
</div>
