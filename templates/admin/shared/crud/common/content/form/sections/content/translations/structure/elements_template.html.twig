{% set locale = hookable_metadata.context.locale %}
{% set form = hookable_metadata.context.form.template %}

<div class="collapse" id="elements-template-{{ locale }}">
    <div class="card-body border-bottom bg-surface-secondary">
        {{ form_label(form) }}
        {{ form_help(form) }}
        <div class="input-group mb-3 cms-autocomplete-group">
            <div>{{ form_widget(form, sylius_test_form_attribute('content-template', locale)) }}</div>
            <button
                class="btn btn-outline-secondary"
                type="button"
                data-action="live#action"
                data-live-action-param="debounce(300)|applyContentTemplate"
                data-live-locale-code-param="{{ locale }}"
                {{ sylius_test_html_attribute('apply-template-button', locale) }}
            >
                {{ ux_icon('tabler:download', {'class': 'icon mx-0'}) }}
            </button>
        </div>
        {{ form_errors(form) }}
    </div>
</div>
