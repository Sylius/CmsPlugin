{% form_theme form hookable_metadata.configuration.form_theme|default('@SyliusAdmin/shared/form_theme.html.twig') %}

{% set ui_state = this.uiState %}

<div class="container-xl cms-form" {{ attributes.defaults(stimulus_controller('@sylius-cms-plugin/admin/ui-state')|stimulus_controller('@sylius-cms-plugin/admin/widget-state')) }}>
    {{ form_start(form, {'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate', 'id': form.vars.id}}) }}
    {% if hookable_metadata.configuration.method is defined %}
        <input type="hidden" name="_method" value="{{ hookable_metadata.configuration.method }}" />
    {% endif %}
    {% set ui_snapshot = { activeLocale: ui_state.active_locale } %}
    {% for locale, key in ui_state.active_elements %}
        {% set ui_snapshot = ui_snapshot|merge({ ('activeElements.' ~ locale): key }) %}
    {% endfor %}
    <div hidden data-state="{{ ui_snapshot|json_encode }}" {{ stimulus_target('@sylius-cms-plugin/admin/ui-state', 'snapshot') }}></div>

    {% if hookable_metadata.configuration.form_errors|default(true) %}
        {{ form_errors(form) }}
    {% endif %}
    {{ form_widget(form._token) }}

    {% hook 'form' with { form, ui_state, form_validated: this.isValidated, component: this } %}

    {{ form_end(form, {render_rest: false}) }}
</div>
