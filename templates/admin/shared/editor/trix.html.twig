{% block sylius_cms_plugin_trix_strategy_widget %}
    {% set uid = id|replace({'[': '_', ']': ''}) %}
    {% set toolbar_id = 'trix-toolbar-' ~ uid %}
    {% set input_id = id ~ '_' ~ content_signature %}

    <div id="trix-editor-{{ uid }}-{{ content_signature }}" {{ sylius_test_html_attribute('editor') }}>
        <input type="hidden" id="{{ input_id }}" name="{{ full_name }}" value="{{ value }}" data-model="norender|{{ full_name }}" />

        <trix-toolbar id="{{ toolbar_id }}"></trix-toolbar>
        <trix-editor input="{{ input_id }}" toolbar="{{ toolbar_id }}" data-live-ignore></trix-editor>
    </div>
{% endblock %}
