{
    "name": "sylius/cms-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "sylius-cms"
    ],
    "description": "CMS plugin for Sylius applications.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "api-platform/state": "^4.0.3",
        "sylius/sylius": "^2.0",
        "league/csv": "^9.1",
        "sylius/telemetry": "^1.0",
        "ehyiah/ux-quill": "^3.6"
    },
    "require-dev": {
        "behat/behat": "^3.14 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "dmore/chrome-mink-driver": "^2.9",
        "doctrine/cache": "^2.2",
        "doctrine/data-fixtures": "^1.7 || ^2.0",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1 || ^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1 || ^1.2",
        "friends-of-behat/symfony-extension": "^2.6 || ^2.7",
        "friends-of-behat/variadic-extension": "^1.6 || ^1.7",
        "lchrusciel/api-test-case": "^6.0",
        "matthiasnoback/symfony-config-test": "^6.2",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "mockery/mockery": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "psr/event-dispatcher": "^1.0",
        "robertfausk/behat-panther-extension": "^1.1 || ^2.0",
        "sylius/test-application": "^2.0.0@alpha",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2 || ^0.3",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/flex": "^2.4",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "stefandoorn/sitemap-plugin": "^2.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Sylius\\CmsPlugin\\": "src/",
            "Tests\\Sylius\\CmsPlugin\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    }
}
